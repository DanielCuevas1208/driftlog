{
  "title": "Field notes merge",
  "base": "The quick brown fox",
  "replicas": [
    {
      "name": "alice-1",
      "text": [
        { "op": "insert", "index": 16, "value": "lazy " }
      ],
      "register": [
        { "op": "set", "value": "Driftlog v0.3" },
        { "op": "set", "value": "Driftlog v0.3-final" }
      ],
      "set": [
        { "op": "add", "value": "erlang" },
        { "op": "add", "value": "gleam" }
      ]
    },
    {
      "name": "bob-1",
      "text": [
        { "op": "delete", "index": 10, "count": 6 },
        { "op": "insert", "index": 13, "value": " dog" }
      ],
      "register": [
        { "op": "set", "value": "draft" }
      ],
      "set": [
        { "op": "add", "value": "crdt" },
        { "op": "add", "value": "draft" },
        { "op": "remove", "value": "draft" }
      ]
    }
  ],
  "expected": {
    "text": "The quick lazy fox dog",
    "register": "Driftlog v0.3-final",
    "set": ["crdt", "erlang", "gleam"]
  }
}
